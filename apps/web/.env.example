# Qdot API (apps/api). Leave empty to run the frontend on mock data.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: base URL used only for the editor's live preview before a code is saved.
# Saved codes always use the shortUrl returned by the API (its QR_REDIRECT_BASE_URL).
# NEXT_PUBLIC_REDIRECT_BASE_URL=https://qr.qdot.com
