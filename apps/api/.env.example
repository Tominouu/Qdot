# Qdot API — copy to .env and adjust. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://qdot:qdot@localhost:5432/qdot
# Connection pool size. Set to 1 only when using the embedded dev DB (pnpm db:embedded).
DATABASE_POOL_MAX=10

# Random string, at least 32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Browser origin(s) of the web app, comma-separated
CORS_ORIGIN=http://localhost:3000

# Base URL encoded in QR codes (codes point to <base>/r/<code>).
# To scan from a phone on your Wi-Fi, use your computer's LAN IP, e.g. http://192.168.1.42:4000
# Production example: https://qr.qdot.com
QR_REDIRECT_BASE_URL=http://localhost:4000

# Set to true behind Caddy/Nginx so visitor IPs come from X-Forwarded-For
TRUST_PROXY=false

# Secure cookies need HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Local GeoIP database (run: pnpm --filter @qdot/api geoip:download)
GEOIP_DB_PATH=data/geoip/dbip-city-lite.mmdb
